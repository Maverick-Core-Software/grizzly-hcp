# C0-only Twilio subaccount SID.
VOICE_C0_TWILIO_ACCOUNT_SID=
# C0-only Twilio auth token; restricted API credentials are preferred for runtime redirects.
VOICE_C0_TWILIO_AUTH_TOKEN=
# C0-only restricted Twilio API key SID.
VOICE_C0_TWILIO_API_KEY_SID=
# C0-only restricted Twilio API key secret.
VOICE_C0_TWILIO_API_KEY_SECRET=
# Dedicated canary DID in E.164 format.
VOICE_C0_CANARY_DID=
# Twilio IncomingPhoneNumber SID for the canary DID; required for the independent route kill switch.
VOICE_C0_CANARY_NUMBER_SID=
# Reviewed C0 Twilio Function ingress URL.
VOICE_C0_INGRESS_URL=
# Reviewed C0 Twilio Function fallback URL.
VOICE_C0_FALLBACK_URL=
# Dedicated C0 LiveKit project URL.
VOICE_C0_LIVEKIT_URL=
# C0-scoped LiveKit API key.
VOICE_C0_LIVEKIT_API_KEY=
# C0-scoped LiveKit API secret.
VOICE_C0_LIVEKIT_API_SECRET=
# C0 LiveKit SIP host.
VOICE_C0_LIVEKIT_SIP_HOST=
# C0-only LiveKit inbound trunk ID.
VOICE_C0_LIVEKIT_TRUNK_ID=
# C0-only LiveKit dispatch-rule ID.
VOICE_C0_LIVEKIT_RULE_ID=
# C0 LiveKit media-encryption mode.
VOICE_C0_LIVEKIT_MEDIA_ENCRYPTION=
# C0 TwiML SIP username.
VOICE_C0_SIP_USERNAME=
# C0 TwiML SIP password.
VOICE_C0_SIP_PASSWORD=
# C0 SIP transport, such as tls.
VOICE_C0_SIP_TRANSPORT=
# C0-scoped OpenAI GPT-Live key.
VOICE_C0_OPENAI_API_KEY=
# C0 Twilio Function staff caller allow-list.
VOICE_C0_ALLOWED_CALLERS=
# C0 Function office transfer destination.
VOICE_C0_OFFICE_NUMBER=
# C0 Function backup transfer destination.
VOICE_C0_BACKUP_NUMBER=
# C0-only ntfy topic for redacted operations alerts.
VOICE_C0_NTFY_TOPIC=
# Optional C0 CallSid-to-LiveKit mapping path, resolved only against the worktree root.
VOICE_C0_MAPPING_PATH=
# C0-only Twilio Sync service SID for detector transfer-intent flags.
VOICE_C0_SYNC_SERVICE_SID=
# C0 runtime gate; leave absent or false until the separately approved rehearsal.
VOICE_C0_ENABLED=
# Rehearsal only: set true only for the approved silent-start rehearsal; remove or set false for normal operation.
VOICE_C0_REHEARSAL_SILENT_START=
# C0 agent caller allow-list; empty refuses every caller.
VOICE_C0_ALLOWLIST=
# Optional absolute shared data directory; absent uses the worktree data/c0 directory.
VOICE_C0_DATA_DIR=
# C0 provider name only; no production provider default is inherited.
VOICE_C0_PROVIDER=
# C0 model name only; no production model default is inherited.
VOICE_C0_MODEL=
# C0 outbox path, resolved only against the worktree root.
VOICE_OUTBOX_PATH=
# C0 outbox stale-record threshold in milliseconds.
VOICE_OUTBOX_STALE_MS=
# C0 monitor interval in milliseconds.
VOICE_OUTBOX_MONITOR_INTERVAL_MS=
