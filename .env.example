# ── Agent model routing (src/agent/model-router.ts) ───────────────────────
# All roles default → Venice (Z.AI models behind Venice proxy), with z.ai / deepseek
# fallback on error.  REASONING/EXTRACTION/CHEAP → zai-org-glm-5-2;
#   VISION → z-ai-glm-5v-turbo.  Override per-role with MAVERICK_<ROLE>_MODEL.
# Escape hatch: any MAVERICK_<ROLE>_MODEL=claude-* routes that role to Anthropic.
# Venice (Pro+ eval 2026-07):
VENICE_API_KEY=
VENICE_BASE_URL=https://api.venice.ai/api/v1
VENICE_TEXT_MODEL=zai-org-glm-5-2
VENICE_VISION_MODEL=z-ai-glm-5v-turbo
ZAI_BASE_URL=https://api.z.ai/api/paas/v4
ZAI_API_KEY=
ZAI_MODEL=glm-5.2
ZAI_VISION_MODEL=glm-5v-turbo
# Optional: route agent z.ai calls through a proxy/gateway instead of z.ai direct.
# MAVERICK_OPENAI_BASE_URL=

# Route HCP writes through the housecall-pro-mcp daemon instead of the built-in
# cookie client. Default off. When true, the daemon must be running and these set:
# HCP_MCP_URL has no default — it must be set explicitly when HCP_VIA_MCP=true.
# Production daemon lives on CT102: http://192.168.1.14:7332/
HCP_VIA_MCP=false
HCP_MCP_URL=
HCP_MCP_TOKEN=

# Customer SMS chatbot
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=       # E.164 format, e.g. +14695551234
CUSTOMER_CHAT_PORT=3012

# Operator SMS alerts (hermes-pc-sms thread). Do NOT reuse TWILIO_PHONE_NUMBER
# as From — that is the customer line. Copy these four from MCC .env:
#   OPS_SMS_FROM = MCC TWILIO_PHONE_NUMBER
#   OPS_SMS_TO   = MCC OPS_SMS_TO
#   OPS_TWILIO_* = MCC TWILIO_ACCOUNT_SID / TWILIO_AUTH_TOKEN
OPS_TWILIO_ACCOUNT_SID=
OPS_TWILIO_AUTH_TOKEN=
OPS_SMS_FROM=
OPS_SMS_TO=
PUBLIC_URL=                # Set to ngrok/tunnel URL in local dev; https://chat.grizzlyelectrical.net in prod

# Employee SMS chatbot (same server, same port, different number)
EMPLOYEE_PHONE_NUMBER=     # E.164 format — internal employee number
