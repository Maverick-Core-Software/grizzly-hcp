# hcp-catalog-sync environment file template
# Copy this file to /opt/hcp-catalog-sync/hcp-catalog-sync.env and adjust values.
# DO NOT commit the live env file or any secrets to version control.

# RAG target: "local" for local Qdrant, "remote" for remote RAG API.
# This job refuses to run with anything but "local" — it runs on the same host
# as the RAG and publishes by file copy plus a direct HTTP call.
RAG_TARGET=local

# Qdrant instance URL (localhost on the server)
QDRANT_URL=http://localhost:6333

# Qdrant collection name for Grizzly HCP data
QDRANT_COLLECTION=grizzly_hcp

# Directory the job copies the finished CSVs into, where the mav-rag ingest
# watcher picks them up
RAG_INGEST_DIR=/mnt/samsung-sata/mav-rag/hcp-exports

# Paths the three exporters write before the results are copied to the ingest
# directory. Note ESTIMATES_EXPORT_CSV_PATH is not the same variable as the jobs
# sync's ESTIMATES_CSV_PATH — both jobs run on this host, so do not mix them up.
PRICEBOOK_CSV_PATH=/opt/hcp-catalog-sync/pricebook.csv
CUSTOMERS_CSV_PATH=/opt/hcp-catalog-sync/customers.csv
ESTIMATES_EXPORT_CSV_PATH=/opt/hcp-catalog-sync/estimates.csv

# Path to the HCP cookies JSON file used for external API authentication.
# This file is a secret — it is never committed to the repository.
# A human produces it by logging into the HCP portal on a Windows PC and
# exporting the session cookies to JSON, then transfers it to this path.
#
# This deliberately points at the jobs sync's copy rather than keeping a second
# copy of the same secret: when the HCP session expires, refreshing that one
# file fixes both jobs at once.
HCP_COOKIES_FILE=/opt/hcp-estimates-sync/secrets/hcp-cookies.json
