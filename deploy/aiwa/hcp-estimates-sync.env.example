# hcp-estimates-sync environment file template
# Copy this file to /opt/hcp-estimates-sync/hcp-estimates-sync.env and adjust values.
# DO NOT commit the live env file or any secrets to version control.

# RAG target: "local" for local Qdrant, "remote" for remote RAG API
RAG_TARGET=local

# Qdrant instance URL (localhost on the server)
QDRANT_URL=http://localhost:6333

# Qdrant collection name for Grizzly HCP data
QDRANT_COLLECTION=grizzly_hcp

# Directory where the job writes the CSV and copies it into the ingest path
RAG_INGEST_DIR=/mnt/samsung-sata/mav-rag/hcp-exports

# Path to the CSV file the job writes before copying to the ingest directory
ESTIMATES_CSV_PATH=/opt/hcp-estimates-sync/estimates.csv

# Path to the HCP cookies JSON file used for external API authentication.
# This file is a secret — it is never committed to the repository.
# A human produces it by logging into the HCP portal on a Windows PC and
# exporting the session cookies to JSON, then transfers it to this path.
HCP_COOKIES_FILE=/opt/hcp-estimates-sync/secrets/hcp-cookies.json
