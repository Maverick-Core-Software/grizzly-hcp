# booking-approval-poller environment file template (CT103)
# Copy to /etc/maverick-integrations/booking-poller.env and fill values.
# DO NOT commit the live env file or any secrets to version control.
# chmod 600 root:root on the live file after install.
#
# Install path convention:
#   WorkingDirectory = /opt/grizzly-hcp
#   EnvironmentFile  = /etc/maverick-integrations/booking-poller.env
#   unit             = booking-approval-poller.service

# HCP MCP daemon (CT102 production). Required — no localhost default in code.
HCP_MCP_URL=

# Bearer token for HCP MCP. Secret — never log the value.
HCP_MCP_TOKEN=

# Numeric pro ids for update_job_schedule (not pro_… UUIDs used by assignTechnician).
CARTER_PRO_ID=
JAIME_PRO_ID=

# Poll interval in milliseconds (PC default: 60000).
BOOKING_POLL_INTERVAL_MS=

# Process timezone. Must be America/Chicago for SCHEDULE local-offset ISO.
TZ=
